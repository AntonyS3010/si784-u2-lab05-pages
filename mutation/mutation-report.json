actAssignmentExpression mutation","replacement":"m_balance -= amount","location":{"start":{"line":48,"column":9},"end":{"line":48,"column":28}},"status":"Killed","static":false,"coveredBy":["31c9b53a-d5dc-5981-83bc-bd22b9c4c52c","113b73cd-f23f-caee-9579-a8fe08d105a5","91d1169c-5731-7c46-f077-66de5cfde438","15563942-105d-1113-7fad-c713fdcff341"],"killedBy":["31c9b53a-d5dc-5981-83bc-bd22b9c4c52c","15563942-105d-1113-7fad-c713fdcff341"]}]}},"projectRoot":"/home/runner/work/si784-2026-ii-si784-2026-ii-u2-lab05-antonys3010/si784-2026-ii-si784-2026-ii-u2-lab05-antonys3010/Bank/Bank.Domain","schemaVersion":"2","testFiles":{"/home/runner/work/si784-2026-ii-si784-2026-ii-u2-lab05-antonys3010/si784-2026-ii-si784-2026-ii-u2-lab05-antonys3010/Bank/Bank.Domain.Tests/BankAccountTests.cs":{"language":"cs","source":"using Xunit;\n\nnamespace Bank.Domain.Tests;\n\npublic class BankAccountTests\n{\n    [Theory]\n    [InlineData(\u0022Mr. Bryan Walton\u0022, 11.99)]\n    [InlineData(\u0022Ana\u0022, 0)]\n    public void Constructor_PreservesCustomerNameAndBalance(string name, double balance)\n    {\n        var account = new BankAccount(name, balance);\n        Assert.Equal(name, account.CustomerName);\n        Assert.Equal(balance, account.Balance);\n    }\n\n    [Theory]\n    [InlineData(11.99, 4.55, 7.44)]\n    [InlineData(12.3, 5.2, 7.1)]\n    [InlineData(10, 10, 0)]\n    [InlineData(10, 0, 10)]\n    [InlineData(0, 0, 0)]\n    public void Debit_WithValidAmount_UpdatesBalance(double balance, double amount, double expected)\n    {\n        var account = new BankAccount(\u0022Mr. Bryan Walton\u0022, balance);\n        account.Debit(amount);\n        Assert.Equal(expected, account.Balance, 10);\n    }\n\n    [Theory]\n    [InlineData(-100, BankAccount.DebitAmountLessThanZeroMessage)]\n    [InlineData(20, BankAccount.DebitAmountExceedsBalanceMessage)]\n    public void Debit_WithInvalidAmount_ThrowsAndPreservesBalance(double amount, string message)\n    {\n        var account = new BankAccount(\u0022Mr. Bryan Walton\u0022, 11.99);\n        var error = Assert.Throws\u003CArgumentOutOfRangeException\u003E(() =\u003E account.Debit(amount));\n        Assert.Equal(\u0022amount\u0022, error.ParamName);\n        Assert.Equal(amount, Assert.IsType\u003Cdouble\u003E(error.ActualValue));\n        Assert.Contains(message, error.Message);\n        Assert.Equal(11.99, account.Balance);\n    }\n\n    [Theory]\n    [InlineData(11.99, 5.77, 17.76)]\n    [InlineData(10, 0, 10)]\n    [InlineData(0, 5, 5)]\n    [InlineData(0, 0, 0)]\n    public void Credit_WithValidAmount_UpdatesBalance(double balance, double amount, double expected)\n    {\n        var account = new BankAccount(\u0022Mr. Bryan Walton\u0022, balance);\n        account.Credit(amount);\n        Assert.Equal(expected, account.Balance, 10);\n    }\n\n    [Fact]\n    public void Credit_WithNegativeAmount_ThrowsAndPreservesBalance()\n    {\n        var account = new BankAccount(\u0022Mr. Bryan Walton\u0022, 11.99);\n        var error = Assert.Throws\u003CArgumentOutOfRangeException\u003E(() =\u003E account.Credit(-1));\n        Assert.Equal(\u0022amount\u0022, error.ParamName);\n        Assert.Equal(11.99, account.Balance);\n    }\n}\n","tests":[{"id":"a0c2459a-4f01-9333-a15a-2deb5e1e026f","name":"Bank.Domain.Tests.BankAccountTests.Constructor_PreservesCustomerNameAndBalance","location":{"start":{"line":7,"column":5},"end":{"line":15,"column":6}}},{"id":"84b7653d-45bd-0dfc-3445-a525edf0a500","name":"Bank.Domain.Tests.BankAccountTests.Constructor_PreservesCustomerNameAndBalance","location":{"start":{"line":7,"column":5},"end":{"line":15,"column":6}}},{"id":"b6eda1b8-13d3-4aac-fe1b-35c9615baf7a","name":"Bank.Domain.Tests.BankAccountTests.Debit_WithValidAmount_UpdatesBalance","location":{"start":{"line":17,"column":5},"end":{"line":28,"column":6}}},{"id":"a148a163-65ae-7c89-7e67-71b926b8e79c","name":"Bank.Domain.Tests.BankAccountTests.Debit_WithValidAmount_UpdatesBalance","location":{"start":{"line":17,"colu