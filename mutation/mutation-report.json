{"files":{"/home/runner/work/si784-2026-ii-si784-2026-ii-u2-lab05-antonys3010/si784-2026-ii-si784-2026-ii-u2-lab05-antonys3010/Bank/Bank.Domain/BankAccount.cs":{"language":"cs","source":"namespace Bank.Domain;\n\n/// \u003Csummary\u003ERepresenta una cuenta bancaria con operaciones de d\u00E9bito y cr\u00E9dito.\u003C/summary\u003E\npublic class BankAccount\n{\n    /// \u003Csummary\u003EMensaje para un d\u00E9bito superior al saldo disponible.\u003C/summary\u003E\n    public const string DebitAmountExceedsBalanceMessage = \u0022Debit amount exceeds balance\u0022;\n    /// \u003Csummary\u003EMensaje para un d\u00E9bito negativo.\u003C/summary\u003E\n    public const string DebitAmountLessThanZeroMessage = \u0022Debit amount is less than zero\u0022;\n    /// \u003Csummary\u003ENombre del titular de la cuenta.\u003C/summary\u003E\n    private readonly string m_customerName;\n    /// \u003Csummary\u003ESaldo actual de la cuenta.\u003C/summary\u003E\n    private double m_balance;\n\n    /// \u003Csummary\u003EInicializa el titular y el saldo de la cuenta.\u003C/summary\u003E\n    /// \u003Cparam name=\u0022customerName\u0022\u003ENombre del titular.\u003C/param\u003E\n    /// \u003Cparam name=\u0022balance\u0022\u003ESaldo inicial.\u003C/param\u003E\n    public BankAccount(string customerName, double balance)\n    {\n        m_customerName = customerName;\n        m_balance = balance;\n    }\n\n    /// \u003Csummary\u003EObtiene el nombre del titular.\u003C/summary\u003E\n    public string CustomerName =\u003E m_customerName;\n    /// \u003Csummary\u003EObtiene el saldo actual.\u003C/summary\u003E\n    public double Balance =\u003E m_balance;\n\n    /// \u003Csummary\u003ERetira un importe del saldo disponible.\u003C/summary\u003E\n    /// \u003Cparam name=\u0022amount\u0022\u003EImporte no negativo que no supera el saldo.\u003C/param\u003E\n    /// \u003Cexception cref=\u0022ArgumentOutOfRangeException\u0022\u003EEl importe es negativo o supera el saldo.\u003C/exception\u003E\n    public void Debit(double amount)\n    {\n        if (amount \u003E m_balance)\n            throw new ArgumentOutOfRangeException(nameof(amount), amount, DebitAmountExceedsBalanceMessage);\n        if (amount \u003C 0)\n            throw new ArgumentOutOfRangeException(nameof(amount), amount, DebitAmountLessThanZeroMessage);\n        m_balance -= amount;\n    }\n\n    /// \u003Csummary\u003EAgrega un importe al saldo de la cuenta.\u003C/summary\u003E\n    /// \u003Cparam name=\u0022amount\u0022\u003EImporte no negativo que se desea acreditar.\u003C/param\u003E\n    /// \u003Cexception cref=\u0022ArgumentOutOfRangeException\u0022\u003EEl importe es negativo.\u003C/exception\u003E\n    public void Credit(double amount)\n    {\n        if (amount \u003C 0)\n            throw new ArgumentOutOfRangeException(nameof(amount));\n        m_balance \u002B= amount;\n    }\n}\n","mutants":[{"id":"0","mutatorName":"Block removal mutation","replacement":"{}","location":{"start":{"line":19,"column":5},"end":{"line":22,"column":6}},"status":"Killed","static":false,"coveredBy":["31c9b53a-d5dc-5981-83bc-bd22b9c4c52c","113b73cd-f23f-caee-9579-a8fe08d105a5","91d1169c-5731-7c46-f077-66de5cfde438","15563942-105d-1113-7fad-c713fdcff341","3d9a1348-5482-2591-8cf5-aa0dd5975d21","daa7140c-8672-b8a0-e097-851362e164ef","84b7653d-45bd-0dfc-3445-a525edf0a500","a0c2459a-4f01-9333-a15a-2deb5e1e026f","8239ac83-8e4c-ce77-6954-4b93c4f2386f","b6eda1b8-13d3-4aac-fe1b-35c9615baf7a","4e9520d2-4f84-d38d-bdfd-ca56e6f64830","7a9a411e-0245-b36f-79ae-0cc638050f96","a148a163-65ae-7c89-7e67-71b926b8e79c","67c7119c-6388-4a7b-5a68-d62c004ae859"],"killedBy":["31c9b53a-d5dc-5981-83bc-bd22b9c4c52c","91d1169c-5731-7c46-f077-66de5cfde438","3d9a1348-5482-2591-8cf5-aa0dd5975d21","daa7140c-8672-b8a0-e097-851362e164ef","84b7653d-45bd-0dfc-3445-a525edf0a500","a0c2459a-4f01-9333-a15a-2deb5e1e026f","8239ac83-8e4c-ce77-6954-4b93c4f2386f","b6eda1b8-13d3-4aac-fe1b-35c9615baf7a","7a9a411e-0245-b36f-79ae-0cc638050f96",